<Activity mc:Ignorable="sap sap2010" x:Class="Main" VisualBasic.Settings="{x:Null}" sap2010:WorkflowViewState.IdRef="ActivityBuilder_1" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation" xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib" xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib" xmlns:sd="clr-namespace:System.Data;assembly=System.Data.Common" xmlns:ue="clr-namespace:UiPath.Excel;assembly=UiPath.Excel.Activities" xmlns:ueab="clr-namespace:UiPath.Excel.Activities.Business;assembly=UiPath.Excel.Activities" xmlns:ui="http://schemas.uipath.com/workflow/activities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System.Activities</x:String>
      <x:String>System.Activities.Statements</x:String>
      <x:String>System.Activities.Expressions</x:String>
      <x:String>System.Activities.Validation</x:String>
      <x:String>System.Activities.XamlIntegration</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
      <x:String>Microsoft.VisualBasic.Activities</x:String>
      <x:String>System</x:String>
      <x:String>System.Collections</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Collections.ObjectModel</x:String>
      <x:String>System.Data</x:String>
      <x:String>System.Diagnostics</x:String>
      <x:String>System.IO</x:String>
      <x:String>System.Linq</x:String>
      <x:String>System.Text.RegularExpressions</x:String>
      <x:String>System.Xml</x:String>
      <x:String>System.Xml.Linq</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
      <x:String>System.Windows.Markup</x:String>
      <x:String>GlobalVariablesNamespace</x:String>
      <x:String>GlobalConstantsNamespace</x:String>
      <x:String>UiPath.Excel</x:String>
      <x:String>UiPath.Excel.Activities.Business</x:String>
      <x:String>UiPath.Excel.Activities</x:String>
      <x:String>UiPath.Excel.Model</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>mscorlib</AssemblyReference>
      <AssemblyReference>System.Private.CoreLib</AssemblyReference>
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System.Data</AssemblyReference>
      <AssemblyReference>System.Data.Common</AssemblyReference>
      <AssemblyReference>System.ObjectModel</AssemblyReference>
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>Microsoft.CSharp</AssemblyReference>
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>System.Linq.Expressions</AssemblyReference>
      <AssemblyReference>System.Xml</AssemblyReference>
      <AssemblyReference>System.Xml.Linq</AssemblyReference>
      <AssemblyReference>System.Xaml</AssemblyReference>
      <AssemblyReference>System.ComponentModel.TypeConverter</AssemblyReference>
      <AssemblyReference>System.Runtime</AssemblyReference>
      <AssemblyReference>System.Collections</AssemblyReference>
      <AssemblyReference>WindowsBase</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
      <AssemblyReference>UiPath.Excel.Activities</AssemblyReference>
      <AssemblyReference>UiPath.Excel</AssemblyReference>
      <AssemblyReference>UiPath.Core.Activities</AssemblyReference>
      <AssemblyReference>UiPath.Core</AssemblyReference>
      <AssemblyReference>UiPath.Workflow</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <sap:WorkflowViewStateService.ViewState>
    <scg:Dictionary x:TypeArguments="x:String, x:Object">
      <x:Boolean x:Key="ShouldExpandAll">True</x:Boolean>
      <x:Boolean x:Key="ShouldCollapseAll">False</x:Boolean>
    </scg:Dictionary>
  </sap:WorkflowViewStateService.ViewState>
  <Sequence DisplayName="Main Sequence" sap2010:WorkflowViewState.IdRef="Sequence_Main">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="reportPath" />
      <Variable x:TypeArguments="x:String" Name="posPattern" />
      <Variable x:TypeArguments="x:String" Name="negPattern" />
      <Variable x:TypeArguments="scg:List(x:String)" Name="productNames" />
      <Variable x:TypeArguments="scg:List(x:String)" Name="productFolders" />
    </Sequence.Variables>

    <Assign DisplayName="Set Report Path" sap2010:WorkflowViewState.IdRef="Assign_ReportPath">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[reportPath]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">Documents\Sentiment_Analysis_Report.xlsx</InArgument>
      </Assign.Value>
    </Assign>

    <Assign DisplayName="Set Positive Pattern" sap2010:WorkflowViewState.IdRef="Assign_PosPattern">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[posPattern]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">good|great|excellent|love|loved|best|amazing|awesome|nice|happy|perfect|recommend|satisfied|quality|worth|durable|fast|smooth|comfortable</InArgument>
      </Assign.Value>
    </Assign>

    <Assign DisplayName="Set Negative Pattern" sap2010:WorkflowViewState.IdRef="Assign_NegPattern">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[negPattern]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">bad|worst|poor|hate|disappointing|disappointed|waste|terrible|broken|defective|refund|issue|problem|damaged|late|slow|cheap|not working|tearing|cracked</InArgument>
      </Assign.Value>
    </Assign>

    <Assign DisplayName="Set Product Names" sap2010:WorkflowViewState.IdRef="Assign_ProductNames">
      <Assign.To>
        <OutArgument x:TypeArguments="scg:List(x:String)">[productNames]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="scg:List(x:String)">[New List(Of String) From {"Wireless Bluetooth Headphones", "Kitchen Blender 750W", "Running Shoes Size 9"}]</InArgument>
      </Assign.Value>
    </Assign>

    <Assign DisplayName="Set Product Folders" sap2010:WorkflowViewState.IdRef="Assign_ProductFolders">
      <Assign.To>
        <OutArgument x:TypeArguments="scg:List(x:String)">[productFolders]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="scg:List(x:String)">[New List(Of String) From {"Documents\Reviews\Product1", "Documents\Reviews\Product2", "Documents\Reviews\Product3"}]</InArgument>
      </Assign.Value>
    </Assign>

    <ui:LogMessage DisplayName="Log Start" Level="Info" sap2010:WorkflowViewState.IdRef="LogMessage_Start" Message="[&quot;Smart Document Understanding Sentiment Analysis started for &quot; &amp; productNames.Count.ToString &amp; &quot; products.&quot;]" />

    <ueab:ExcelApplicationCard Password="{x:Null}" ReadFormatting="{x:Null}" SensitivityLabel="{x:Null}" DisplayName="Use Excel File" sap2010:WorkflowViewState.IdRef="ExcelApplicationCard_1" ResizeWindow="None" SensitivityOperation="None" WorkbookPath="[reportPath]">
      <ueab:ExcelApplicationCard.Body>
        <ActivityAction x:TypeArguments="ue:IWorkbookQuickHandle">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="ue:IWorkbookQuickHandle" Name="Excel" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Do" sap2010:WorkflowViewState.IdRef="Sequence_ExcelDo">

            <ueab:WriteCellX Cell="[Excel.Sheet(&quot;Details&quot;).Cell(&quot;A1&quot;)]" DisplayName="Write Cell" sap2010:WorkflowViewState.IdRef="WriteCellX_DH1" Value="[&quot;Product&quot;]" />
            <ueab:WriteCellX Cell="[Excel.Sheet(&quot;Details&quot;).Cell(&quot;B1&quot;)]" DisplayName="Write Cell" sap2010:WorkflowViewState.IdRef="WriteCellX_DH2" Value="[&quot;Document Name&quot;]" />
            <ueab:WriteCellX Cell="[Excel.Sheet(&quot;Details&quot;).Cell(&quot;C1&quot;)]" DisplayName="Write Cell" sap2010:WorkflowViewState.IdRef="WriteCellX_DH3" Value="[&quot;Extracted Text Snippet&quot;]" />
            <ueab:WriteCellX Cell="[Excel.Sheet(&quot;Details&quot;).Cell(&quot;D1&quot;)]" DisplayName="Write Cell" sap2010:WorkflowViewState.IdRef="WriteCellX_DH4" Value="[&quot;Positive Keywords&quot;]" />
            <ueab:WriteCellX Cell="[Excel.Sheet(&quot;Details&quot;).Cell(&quot;E1&quot;)]" DisplayName="Write Cell" sap2010:WorkflowViewState.IdRef="WriteCellX_DH5" Value="[&quot;Negative Keywords&quot;]" />
            <ueab:WriteCellX Cell="[Excel.Sheet(&quot;Details&quot;).Cell(&quot;F1&quot;)]" DisplayName="Write Cell" sap2010:WorkflowViewState.IdRef="WriteCellX_DH6" Value="[&quot;Sentiment Score&quot;]" />
            <ueab:WriteCellX Cell="[Excel.Sheet(&quot;Details&quot;).Cell(&quot;G1&quot;)]" DisplayName="Write Cell" sap2010:WorkflowViewState.IdRef="WriteCellX_DH7" Value="[&quot;Sentiment Label&quot;]" />

            <ueab:WriteCellX Cell="[Excel.Sheet(&quot;Summary&quot;).Cell(&quot;A1&quot;)]" DisplayName="Write Cell" sap2010:WorkflowViewState.IdRef="WriteCellX_SH1" Value="[&quot;Product&quot;]" />
            <ueab:WriteCellX Cell="[Excel.Sheet(&quot;Summary&quot;).Cell(&quot;B1&quot;)]" DisplayName="Write Cell" sap2010:WorkflowViewState.IdRef="WriteCellX_SH2" Value="[&quot;Total Reviews&quot;]" />
            <ueab:WriteCellX Cell="[Excel.Sheet(&quot;Summary&quot;).Cell(&quot;C1&quot;)]" DisplayName="Write Cell" sap2010:WorkflowViewState.IdRef="WriteCellX_SH3" Value="[&quot;Positive %&quot;]" />
            <ueab:WriteCellX Cell="[Excel.Sheet(&quot;Summary&quot;).Cell(&quot;D1&quot;)]" DisplayName="Write Cell" sap2010:WorkflowViewState.IdRef="WriteCellX_SH4" Value="[&quot;Negative %&quot;]" />
            <ueab:WriteCellX Cell="[Excel.Sheet(&quot;Summary&quot;).Cell(&quot;E1&quot;)]" DisplayName="Write Cell" sap2010:WorkflowViewState.IdRef="WriteCellX_SH5" Value="[&quot;Neutral %&quot;]" />
            <ueab:WriteCellX Cell="[Excel.Sheet(&quot;Summary&quot;).Cell(&quot;F1&quot;)]" DisplayName="Write Cell" sap2010:WorkflowViewState.IdRef="WriteCellX_SH6" Value="[&quot;Why Positive (top themes)&quot;]" />
            <ueab:WriteCellX Cell="[Excel.Sheet(&quot;Summary&quot;).Cell(&quot;G1&quot;)]" DisplayName="Write Cell" sap2010:WorkflowViewState.IdRef="WriteCellX_SH7" Value="[&quot;Why Negative (top themes)&quot;]" />

            <ForEach x:TypeArguments="x:Int32" DisplayName="For Each Product" sap2010:WorkflowViewState.IdRef="ForEach_Products" Values="[Enumerable.Range(0, productNames.Count)]">
              <ForEach.Body>
                <ActivityAction x:TypeArguments="x:Int32">
                  <ActivityAction.Argument>
                    <DelegateInArgument x:TypeArguments="x:Int32" Name="pIndex" />
                  </ActivityAction.Argument>
                  <Sequence DisplayName="Process Product" sap2010:WorkflowViewState.IdRef="Sequence_ProcessProduct">
                    <Sequence.Variables>
                      <Variable x:TypeArguments="x:String" Name="currentProductName" />
                      <Variable x:TypeArguments="x:String" Name="currentProductFolder" />
                      <Variable x:TypeArguments="scg:List(x:String)" Name="productFiles" />
                      <Variable x:TypeArguments="x:Int32" Name="positiveDocs" />
                      <Variable x:TypeArguments="x:Int32" Name="negativeDocs" />
                      <Variable x:TypeArguments="x:Int32" Name="neutralDocs" />
                      <Variable x:TypeArguments="scg:List(x:String)" Name="allPosWordsFound" />
                      <Variable x:TypeArguments="scg:List(x:String)" Name="allNegWordsFound" />
                      <Variable x:TypeArguments="x:String" Name="topPositiveReasons" />
                      <Variable x:TypeArguments="x:String" Name="topNegativeReasons" />
                    </Sequence.Variables>

                    <Assign DisplayName="Get Product Name" sap2010:WorkflowViewState.IdRef="Assign_ProdName">
                      <Assign.To>
                        <OutArgument x:TypeArguments="x:String">[currentProductName]</OutArgument>
                      </Assign.To>
                      <Assign.Value>
                        <InArgument x:TypeArguments="x:String">[productNames(pIndex)]</InArgument>
                      </Assign.Value>
                    </Assign>

                    <Assign DisplayName="Get Product Folder" sap2010:WorkflowViewState.IdRef="Assign_ProdFolder">
                      <Assign.To>
                        <OutArgument x:TypeArguments="x:String">[currentProductFolder]</OutArgument>
                      </Assign.To>
                      <Assign.Value>
                        <InArgument x:TypeArguments="x:String">[productFolders(pIndex)]</InArgument>
                      </Assign.Value>
                    </Assign>

                    <Assign DisplayName="Get Review Files" sap2010:WorkflowViewState.IdRef="Assign_ReviewFiles">
                      <Assign.To>
                        <OutArgument x:TypeArguments="scg:List(x:String)">[productFiles]</OutArgument>
                      </Assign.To>
                      <Assign.Value>
                        <InArgument x:TypeArguments="scg:List(x:String)">[System.IO.Directory.GetFiles(currentProductFolder, "*.txt").ToList]</InArgument>
                      </Assign.Value>
                    </Assign>

                    <Assign DisplayName="Init Positive Words List" sap2010:WorkflowViewState.IdRef="Assign_InitPosWords">
                      <Assign.To>
                        <OutArgument x:TypeArguments="scg:List(x:String)">[allPosWordsFound]</OutArgument>
                      </Assign.To>
                      <Assign.Value>
                        <InArgument x:TypeArguments="scg:List(x:String)">[New List(Of String)]</InArgument>
                      </Assign.Value>
                    </Assign>

                    <Assign DisplayName="Init Negative Words List" sap2010:WorkflowViewState.IdRef="Assign_InitNegWords">
                      <Assign.To>
                        <OutArgument x:TypeArguments="scg:List(x:String)">[allNegWordsFound]</OutArgument>
                      </Assign.To>
                      <Assign.Value>
                        <InArgument x:TypeArguments="scg:List(x:String)">[New List(Of String)]</InArgument>
                      </Assign.Value>
                    </Assign>

                    <ui:LogMessage DisplayName="Log Product Start" Level="Info" sap2010:WorkflowViewState.IdRef="LogMessage_ProductStart" Message="[&quot;Analyzing product: &quot; &amp; currentProductName &amp; &quot; (&quot; &amp; productFiles.Count.ToString &amp; &quot; reviews)&quot;]" />

                    <ForEach x:TypeArguments="x:String" DisplayName="For Each Review" sap2010:WorkflowViewState.IdRef="ForEach_Reviews" Values="[productFiles]">
                      <ForEach.Body>
                        <ActivityAction x:TypeArguments="x:String">
                          <ActivityAction.Argument>
                            <DelegateInArgument x:TypeArguments="x:String" Name="currentDoc" />
                          </ActivityAction.Argument>
                          <Sequence DisplayName="Process Review" sap2010:WorkflowViewState.IdRef="Sequence_ProcessReview">
                            <Sequence.Variables>
                              <Variable x:TypeArguments="x:String" Name="docText" />
                              <Variable x:TypeArguments="x:Int32" Name="posCount" />
                              <Variable x:TypeArguments="x:Int32" Name="negCount" />
                              <Variable x:TypeArguments="x:Int32" Name="totalScore" />
                              <Variable x:TypeArguments="x:String" Name="sentimentLabel" />
                            </Sequence.Variables>

                            <Assign DisplayName="Extract Review Text" sap2010:WorkflowViewState.IdRef="Assign_ExtractText">
                              <Assign.To>
                                <OutArgument x:TypeArguments="x:String">[docText]</OutArgument>
                              </Assign.To>
                              <Assign.Value>
                                <InArgument x:TypeArguments="x:String">[System.IO.File.ReadAllText(currentDoc)]</InArgument>
                              </Assign.Value>
                            </Assign>

                            <Assign DisplayName="Count Positive Keywords" sap2010:WorkflowViewState.IdRef="Assign_PosCount">
                              <Assign.To>
                                <OutArgument x:TypeArguments="x:Int32">[posCount]</OutArgument>
                              </Assign.To>
                              <Assign.Value>
                                <InArgument x:TypeArguments="x:Int32">[System.Text.RegularExpressions.Regex.Matches(docText.ToLower, posPattern).Count]</InArgument>
                              </Assign.Value>
                            </Assign>

                            <Assign DisplayName="Count Negative Keywords" sap2010:WorkflowViewState.IdRef="Assign_NegCount">
                              <Assign.To>
                                <OutArgument x:TypeArguments="x:Int32">[negCount]</OutArgument>
                              </Assign.To>
                              <Assign.Value>
                                <InArgument x:TypeArguments="x:Int32">[System.Text.RegularExpressions.Regex.Matches(docText.ToLower, negPattern).Count]</InArgument>
                              </Assign.Value>
                            </Assign>

                            <Assign DisplayName="Calculate Sentiment Score" sap2010:WorkflowViewState.IdRef="Assign_TotalScore">
                              <Assign.To>
                                <OutArgument x:TypeArguments="x:Int32">[totalScore]</OutArgument>
                              </Assign.To>
                              <Assign.Value>
                                <InArgument x:TypeArguments="x:Int32">[posCount - negCount]</InArgument>
                              </Assign.Value>
                            </Assign>

                            <Assign DisplayName="Collect Positive Words" sap2010:WorkflowViewState.IdRef="Assign_CollectPosWords">
                              <Assign.To>
                                <OutArgument x:TypeArguments="scg:List(x:String)">[allPosWordsFound]</OutArgument>
                              </Assign.To>
                              <Assign.Value>
                                <InArgument x:TypeArguments="scg:List(x:String)">[allPosWordsFound.Concat(System.Text.RegularExpressions.Regex.Matches(docText.ToLower, posPattern).Cast(Of System.Text.RegularExpressions.Match)().Select(Function(m) m.Value)).ToList()]</InArgument>
                              </Assign.Value>
                            </Assign>

                            <Assign DisplayName="Collect Negative Words" sap2010:WorkflowViewState.IdRef="Assign_CollectNegWords">
                              <Assign.To>
                                <OutArgument x:TypeArguments="scg:List(x:String)">[allNegWordsFound]</OutArgument>
                              </Assign.To>
                              <Assign.Value>
                                <InArgument x:TypeArguments="scg:List(x:String)">[allNegWordsFound.Concat(System.Text.RegularExpressions.Regex.Matches(docText.ToLower, negPattern).Cast(Of System.Text.RegularExpressions.Match)().Select(Function(m) m.Value)).ToList()]</InArgument>
                              </Assign.Value>
                            </Assign>

                            <If Condition="[totalScore &gt; 0]" DisplayName="Check Sentiment" sap2010:WorkflowViewState.IdRef="If_Sentiment">
                              <If.Then>
                                <Sequence DisplayName="Positive" sap2010:WorkflowViewState.IdRef="Sequence_Positive">
                                  <Assign DisplayName="Set Label Positive" sap2010:WorkflowViewState.IdRef="Assign_LabelPos">
                                    <Assign.To>
                                      <OutArgument x:TypeArguments="x:String">[sentimentLabel]</OutArgument>
                                    </Assign.To>
                                    <Assign.Value>
                                      <InArgument x:TypeArguments="x:String">Positive</InArgument>
                                    </Assign.Value>
                                  </Assign>
                                  <Assign DisplayName="Increment Positive Docs" sap2010:WorkflowViewState.IdRef="Assign_IncPos">
                                    <Assign.To>
                                      <OutArgument x:TypeArguments="x:Int32">[positiveDocs]</OutArgument>
                                    </Assign.To>
                                    <Assign.Value>
                                      <InArgument x:TypeArguments="x:Int32">[positiveDocs + 1]</InArgument>
                                    </Assign.Value>
                                  </Assign>
                                </Sequence>
                              </If.Then>
                              <If.Else>
                                <If Condition="[totalScore &lt; 0]" DisplayName="Check Negative" sap2010:WorkflowViewState.IdRef="If_Negative">
                                  <If.Then>
                                    <Sequence DisplayName="Negative" sap2010:WorkflowViewState.IdRef="Sequence_Negative">
                                      <Assign DisplayName="Set Label Negative" sap2010:WorkflowViewState.IdRef="Assign_LabelNeg">
                                        <Assign.To>
                                          <OutArgument x:TypeArguments="x:String">[sentimentLabel]</OutArgument>
                                        </Assign.To>
                                        <Assign.Value>
                                          <InArgument x:TypeArguments="x:String">Negative</InArgument>
                                        </Assign.Value>
                                      </Assign>
                                      <Assign DisplayName="Increment Negative Docs" sap2010:WorkflowViewState.IdRef="Assign_IncNeg">
                                        <Assign.To>
                                          <OutArgument x:TypeArguments="x:Int32">[negativeDocs]</OutArgument>
                                        </Assign.To>
                                        <Assign.Value>
                                          <InArgument x:TypeArguments="x:Int32">[negativeDocs + 1]</InArgument>
                                        </Assign.Value>
                                      </Assign>
                                    </Sequence>
                                  </If.Then>
                                  <If.Else>
                                    <Sequence DisplayName="Neutral" sap2010:WorkflowViewState.IdRef="Sequence_Neutral">
                                      <Assign DisplayName="Set Label Neutral" sap2010:WorkflowViewState.IdRef="Assign_LabelNeutral">
                                        <Assign.To>
                                          <OutArgument x:TypeArguments="x:String">[sentimentLabel]</OutArgument>
                                        </Assign.To>
                                        <Assign.Value>
                                          <InArgument x:TypeArguments="x:String">Neutral</InArgument>
                                        </Assign.Value>
                                      </Assign>
                                      <Assign DisplayName="Increment Neutral Docs" sap2010:WorkflowViewState.IdRef="Assign_IncNeutral">
                                        <Assign.To>
                                          <OutArgument x:TypeArguments="x:Int32">[neutralDocs]</OutArgument>
                                        </Assign.To>
                                        <Assign.Value>
                                          <InArgument x:TypeArguments="x:Int32">[neutralDocs + 1]</InArgument>
                                        </Assign.Value>
                                      </Assign>
                                    </Sequence>
                                  </If.Else>
                                </If>
                              </If.Else>
                            </If>

                            <ueab:WriteCellX AutoIncrementRow="True" Cell="[Excel.Sheet(&quot;Details&quot;).Cell(&quot;A2&quot;)]" DisplayName="Write Cell" sap2010:WorkflowViewState.IdRef="WriteCellX_DA" Value="[currentProductName]" />
                            <ueab:WriteCellX AutoIncrementRow="True" Cell="[Excel.Sheet(&quot;Details&quot;).Cell(&quot;B2&quot;)]" DisplayName="Write Cell" sap2010:WorkflowViewState.IdRef="WriteCellX_DB" Value="[System.IO.Path.GetFileName(currentDoc)]" />
                            <ueab:WriteCellX AutoIncrementRow="True" Cell="[Excel.Sheet(&quot;Details&quot;).Cell(&quot;C2&quot;)]" DisplayName="Write Cell" sap2010:WorkflowViewState.IdRef="WriteCellX_DC" Value="[If(docText.Length &gt; 120, docText.Substring(0,120) &amp; &quot;...&quot;, docText)]" />
                            <ueab:WriteCellX AutoIncrementRow="True" Cell="[Excel.Sheet(&quot;Details&quot;).Cell(&quot;D2&quot;)]" DisplayName="Write Cell" sap2010:WorkflowViewState.IdRef="WriteCellX_DD" Value="[posCount.ToString]" />
                            <ueab:WriteCellX AutoIncrementRow="True" Cell="[Excel.Sheet(&quot;Details&quot;).Cell(&quot;E2&quot;)]" DisplayName="Write Cell" sap2010:WorkflowViewState.IdRef="WriteCellX_DE" Value="[negCount.ToString]" />
                            <ueab:WriteCellX AutoIncrementRow="True" Cell="[Excel.Sheet(&quot;Details&quot;).Cell(&quot;F2&quot;)]" DisplayName="Write Cell" sap2010:WorkflowViewState.IdRef="WriteCellX_DF" Value="[totalScore.ToString]" />
                            <ueab:WriteCellX AutoIncrementRow="True" Cell="[Excel.Sheet(&quot;Details&quot;).Cell(&quot;G2&quot;)]" DisplayName="Write Cell" sap2010:WorkflowViewState.IdRef="WriteCellX_DG" Value="[sentimentLabel]" />

                          </Sequence>
                        </ActivityAction>
                      </ForEach.Body>
                    </ForEach>

                    <Assign DisplayName="Determine Top Positive Reasons" sap2010:WorkflowViewState.IdRef="Assign_TopPos">
                      <Assign.To>
                        <OutArgument x:TypeArguments="x:String">[topPositiveReasons]</OutArgument>
                      </Assign.To>
                      <Assign.Value>
                        <InArgument x:TypeArguments="x:String">[If(allPosWordsFound.Count > 0, String.Join(", ", allPosWordsFound.Distinct().Take(5)), "No strong positive themes found")]</InArgument>
                      </Assign.Value>
                    </Assign>

                    <Assign DisplayName="Determine Top Negative Reasons" sap2010:WorkflowViewState.IdRef="Assign_TopNeg">
                      <Assign.To>
                        <OutArgument x:TypeArguments="x:String">[topNegativeReasons]</OutArgument>
                      </Assign.To>
                      <Assign.Value>
                        <InArgument x:TypeArguments="x:String">[If(allNegWordsFound.Count > 0, String.Join(", ", allNegWordsFound.Distinct().Take(5)), "No strong negative themes found")]</InArgument>
                      </Assign.Value>
                    </Assign>

                    <ueab:WriteCellX AutoIncrementRow="True" Cell="[Excel.Sheet(&quot;Summary&quot;).Cell(&quot;A2&quot;)]" DisplayName="Write Cell" sap2010:WorkflowViewState.IdRef="WriteCellX_SA" Value="[currentProductName]" />
                    <ueab:WriteCellX AutoIncrementRow="True" Cell="[Excel.Sheet(&quot;Summary&quot;).Cell(&quot;B2&quot;)]" DisplayName="Write Cell" sap2010:WorkflowViewState.IdRef="WriteCellX_SB" Value="[productFiles.Count.ToString]" />
                    <ueab:WriteCellX AutoIncrementRow="True" Cell="[Excel.Sheet(&quot;Summary&quot;).Cell(&quot;C2&quot;)]" DisplayName="Write Cell" sap2010:WorkflowViewState.IdRef="WriteCellX_SC" Value="[(positiveDocs * 100.0 / productFiles.Count).ToString(&quot;0.0&quot;) &amp; &quot;%&quot;]" />
                    <ueab:WriteCellX AutoIncrementRow="True" Cell="[Excel.Sheet(&quot;Summary&quot;).Cell(&quot;D2&quot;)]" DisplayName="Write Cell" sap2010:WorkflowViewState.IdRef="WriteCellX_SD" Value="[(negativeDocs * 100.0 / productFiles.Count).ToString(&quot;0.0&quot;) &amp; &quot;%&quot;]" />
